# Pinned versions consumed by setup.py. Keep in sync with tools.lock.json.
# Bumping any of these is a deliberate change; setup.py --check refuses to
# proceed if the installed version does not match, so a bump here is what
# forces every operator to redo Wave 1.
#
# Node/npm minimums come from the claude-context monorepo's package.json
# engines.node ">=20". Docker minimum is the earliest release with
# `docker compose` (v2) built in, which the Milvus recipe uses.

CLAUDE_CONTEXT_MCP_VERSION=0.1.15
CLAUDE_CONTEXT_CORE_VERSION=0.1.15
NODE_ENGINES=>=20
NPM_MIN_VERSION=10.0.0

MILVUS_IMAGE=milvusdb/milvus
MILVUS_VERSION=v2.5.20
MILVUS_ETCD_IMAGE=quay.io/coreos/etcd
MILVUS_ETCD_VERSION=v3.5.5
MILVUS_MINIO_IMAGE=quay.io/minio/minio
MILVUS_MINIO_VERSION=RELEASE.2023-03-20T20-16-18Z
MILVUS_GRPC_PORT=19530
MILVUS_HOST=127.0.0.1
DOCKER_MIN_VERSION=20.10.13
DOCKER_COMPOSE_MIN_VERSION=2.0.0

OLLAMA_MIN_VERSION=0.3.0
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_DIM=768

# claude-context env vars used by the local-only path. These are the
# names the MCP server reads at boot; setup.py writes them into the
# per-scan environment when it spawns `npx @zilliz/claude-context-mcp`.
EMBEDDING_PROVIDER=Ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://127.0.0.1:11434
MILVUS_TOKEN=

# These MUST stay unset for the local-only path. setup.py refuses to
# proceed if any of them are set in the environment when --check or
# --install runs, because their presence turns claude-context back
# into the quickstart hosted path this lab is deliberately not
# measuring.
FORBIDDEN_ENV_VARS=OPENAI_API_KEY,VOYAGEAI_API_KEY,GEMINI_API_KEY,OPENROUTER_API_KEY,ZILLIZ_URI,ZILLIZ_CLOUD_URI,ZILLIZ_TOKEN,ZILLIZ_CLOUD_TOKEN
